<ol class="post-list">
  {%- for post in posts %}
  <li class="post-item">
    <time datetime="{{ post.date | isoDate }}">{{ post.date | dateShort }}</time>
    <div>
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.description }}</p>
      {%- set tags = post.data.tags %}
      {% include "partials/tags.njk" %}
    </div>
  </li>
  {%- endfor %}
</ol>
