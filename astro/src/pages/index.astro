---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import ProjectList from "../components/ProjectList.astro";
import Gallery from "../components/Gallery.astro";
import { SITE } from "../site.config";
import { url } from "../lib/format";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const featured = (await getCollection("projects", ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p class="lede">{SITE.lede}<span>{SITE.ledeMore}</span></p>
  </section>

  <h2 class="section-title">Последни публикации</h2>
  <PostList posts={posts} />
  <p><a class="more" href={url("blog/")}>Всички публикации</a></p>

  <h2 class="section-title">Избрани проекти</h2>
  <ProjectList projects={featured} heading="h3" empty="Още няма избрани проекти. Задай featured = true на проект, за да се появи тук." />
  <p><a class="more" href={url("projects/")}>Всички проекти</a></p>

  <h2 class="section-title">От галерията</h2>
  <Gallery limit={4} strip />
  <p><a class="more" href={url("gallery/")}>Цялата галерия</a></p>
</Base>
