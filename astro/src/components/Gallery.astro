---
// Галерия: Astro оптимизира снимките при билда (WebP, точни размери), lightbox-ът е ~1 KB JS.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import captions from "../data/gallery.json";
interface Props { limit?: number; strip?: boolean }
const { limit, strip = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/gallery/*.{jpg,jpeg,png,webp}", { eager: true });
const byName = Object.fromEntries(Object.entries(files).map(([path, mod]) => [path.split("/").pop()!, mod.default]));
const list = captions.filter((c) => byName[c.file]).slice(0, limit);
const items = await Promise.all(
  list.map(async (c) => ({
    ...c,
    src: byName[c.file],
    full: await getImage({ src: byName[c.file], width: 1600, format: "webp" }),
  }))
);
---
<ul class:list={["gallery", { "gallery-strip": strip }]}>
  {items.map((item) => (
    <li>
      <figure>
        <a href={item.full.src} data-lightbox data-caption={item.title}>
          <Image src={item.src} alt={item.title} widths={[400, 800]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 100vw" format="webp" />
        </a>
        {!strip && <figcaption>{item.title}</figcaption>}
      </figure>
    </li>
  ))}
</ul>

<script src="../scripts/lightbox.js"></script>
