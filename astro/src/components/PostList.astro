---
import type { CollectionEntry } from "astro:content";
import Tags from "./Tags.astro";
import { url, dateShort } from "../lib/format";
interface Props { posts: CollectionEntry<"blog">[] }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map((post) => (
    <li class="post-item">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateShort(post.data.date)}</time>
      <div>
        <h3><a href={url(`blog/${post.id}/`)}>{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <Tags tags={post.data.tags} />
      </div>
    </li>
  ))}
</ol>
