---
import "../styles/site.css";
import "../styles/shiki.css";
import { SITE } from "../site.config";
import { url, dateLong } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
  /** Зарежда CSS на KaTeX (само на страници с формули). */
  math?: boolean;
}
const { title, description = SITE.description, math = false } = Astro.props;
const pageTitle = title ? `${title} – ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;

const nav = [
  { href: url("blog/"), label: "Блог", match: [url("blog/"), url("tags/")] },
  { href: url("projects/"), label: "Проекти", match: [url("projects/")] },
  { href: url("gallery/"), label: "Галерия", match: [url("gallery/")] },
];
const builtAt = dateLong(new Date());
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url("rss.xml")} />
    {
      math && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css"
          integrity="sha384-3rdsX6e5mueWyoweR9NIVmtEsUkokpBT/0ALqKKIBMr9j4qhHkaIkAcGgsE6uVlp"
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <div class="wrap">
      <header class="site-header">
        <a class="brand" href={url()}>{SITE.title}</a>
        <nav class="site-nav" aria-label="Основна навигация">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.match.some((m) => path.startsWith(m)) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>Генерирано с {Astro.generator.replace(" v", " ")} на {builtAt}</p>
        <ul>
          <li><a href={url("rss.xml")}>RSS</a></li>
          <li><a href={`https://github.com/${SITE.githubUser}`}>GitHub</a></li>
        </ul>
      </footer>
    </div>
  </body>
</html>
